# Optional: final HTTPS production domain. Without it, Vercel's production URL is used.
# Preview deployments and localhost are noindex.
SITE_URL=
# Email notifications: server-only values. Never paste real keys into GitHub or chat.
# Verified sender on your own domain (not an arbitrary Gmail From address).
RESEND_API_KEY=
EMAIL_FROM=
# Shared Redis protects the serverless email API against duplicate submissions and spam.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Generate a random secret of at least 32 characters.
LEAD_HASH_SECRET=
